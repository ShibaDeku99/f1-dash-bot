# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Discord Application ID
DISCORD_CLIENT_ID=your_client_id_here

# Discord Guild ID (Server ID) - optional, for instant command registration during dev
# Remove or leave empty to register commands globally
DISCORD_GUILD_ID=your_guild_id_here

# Channels for auto-notifications (right-click channel in Discord → Copy Channel ID)
# Channel for race control alerts (yellow/red flags, safety car, investigations)
RACE_CONTROL_CHANNEL_ID=your_channel_id_here

# Channel for live leaderboard (single pinned message that auto-updates every 30s)
LIVE_LEADERBOARD_CHANNEL_ID=your_channel_id_here

# Channel for team radio notifications
TEAM_RADIO_CHANNEL_ID=your_channel_id_here

# Channel for session start/end and pre-race reminder alerts
SESSION_ALERT_CHANNEL_ID=your_channel_id_here
